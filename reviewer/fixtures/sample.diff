+/** Applies a percentage discount (0-100) to a price in cents and rounds to whole cents. */
+export function applyDiscount(priceCents: number, percent: number): number {
+  if (percent < 0 || percent > 100) {
+    throw new Error(`percent must be between 0 and 100, got ${percent}`);
+  }
+  return Math.round(priceCents - priceCents * percent);
+}

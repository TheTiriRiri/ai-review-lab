{
  "name": "10x-ai-review-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Sandbox for AI code review pipelines on GitHub Actions (10xDevs module 5)",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "workspaces": [
    "reviewer"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p reviewer/tsconfig.json",
    "build": "npm run -w reviewer build",
    "eval": "npm run -w reviewer eval --",
    "review": "npm run -w reviewer review --",
    "schema:emit": "npm run -w reviewer schema:emit"
  },
  "devDependencies": {
    "@types/node": "^22",
    "js-yaml": "5.4.2",
    "typescript": "^6",
    "vitest": "^5"
  }
}
